<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must be kept in sync with InteractivePreviewView -->
    <attr name="scaleMode" format="enum">
        <enum name="crop" value="0"/>
        <enum name="fill" value="0"/>
        <enum name="fit" value="1"/>
    </attr>

    <!-- Must be kept in sync with InteractivePreviewView -->
    <attr name="position" format="enum">
        <enum name="start" value="0"/>
        <enum name="center" value="1"/>
        <enum name="end" value="2"/>
    </attr>

    <attr name="previewBackgroundColor" format="color" />
    <attr name="isPinchToZoomEnabled" format="boolean" />
    <attr name="isTapToFocusEnabled" format="boolean" />

    <declare-styleable name="InteractivePreviewView">
        <attr name="scaleMode"  />
        <attr name="position" />
        <attr name="previewBackgroundColor" />
        <attr name="contentOverlay" format="reference" />
        <attr name="isPinchToZoomEnabled" />
        <attr name="isTapToFocusEnabled" />
    </declare-styleable>
    <declare-styleable name="PreviewView">
        <attr name="enableZoomOnPinch" format="boolean" />
        <attr name="enableTapToFocus" format="boolean" />
        <attr name="scaleMode"  />
        <attr name="position" />
    </declare-styleable>
</resources>
